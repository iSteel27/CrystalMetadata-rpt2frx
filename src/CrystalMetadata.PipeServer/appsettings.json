{
  "Server": {
    "PipeName": "CrystalMetadataPipe",
    "MaxReportsPerProcess": 200,
    "RequestTimeoutMs": 120000,
    "MaxFrameBytes": 268435456,
    "AllowOutputPath": false,
    "AllowedSids": [],
    "LogDirectory": "logs"
  },
  "Extraction": {
    "IncludeUnusedFields": true,
    "IncludeRawBags": true,
    "IncludeGeneratedSql": false
  },
  "Logging": {
    "MinimumLevel": "Information"
  }
}
